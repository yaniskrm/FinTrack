# Dependencies
node_modules/
.pnp
.pnp.js

# Hide Numbers files and CSV files that may contain sensitive data
*.numbers
releve_*.csv

# Enable Banking private key (Phase 13) — downloaded from the Control Panel,
# never committed. The app reads its content from an env var, not this file.
*.pem

# Build outputs
dist/
build/
.expo/
.next/
.next-verify/
*.tsbuildinfo

# Local DB snapshots (scripts/db-backup.sh) — real login credentials, never commit
.db-backups/

# Expo native build artifacts (regenerated by expo prebuild / pod install)
apps/mobile/ios/Pods/
apps/mobile/ios/build/
apps/mobile/android/build/
apps/mobile/android/.gradle/

# Expo
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/
expo-env.d.ts

# Google Play service account key (EAS submit)
google-services-key.json
google-services.json

# Environment variables — NEVER commit
.env
.env.local
.env.*.local
apps/mobile/.env.local
supabase/functions/.env

# Supabase
supabase/.branches
supabase/.temp

# Testing
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/

# Turborepo
.turbo/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
