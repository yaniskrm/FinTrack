NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Fallback for building absolute auth redirect URLs (email links) when the
# request's Origin header isn't available. Also the base URL the Enable
# Banking consent redirect is built from (Phase 13, apps/web/lib/banking/
# actions.ts) — there it's load-bearing, not just a fallback: it MUST match,
# character for character, the URL whitelisted in the Enable Banking Control
# Panel for whichever application (Sandbox/Production) the credentials below
# belong to. Local dev: http://localhost:3000 (this repo's dev server always
# runs there). Production (Vercel): the real https domain — Enable Banking
# Production applications reject non-https redirect URLs outright.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Open Banking (Phase 13, Enable Banking — https://enablebanking.com/cp/applications).
# Server-only, never NEXT_PUBLIC_ — read only from Server Actions / Route Handlers.
# ENABLE_BANKING_APP_ID: the application ID shown in the Control Panel.
# ENABLE_BANKING_PRIVATE_KEY_BASE64: base64 of the downloaded .pem private key
# file's raw bytes (avoids embedding literal newlines in a .env value) —
# e.g. `base64 -i <app-id>.pem | tr -d '\n'`.
#
# Sandbox vs Production: Enable Banking's Control Panel only lets you
# register http://localhost redirect URLs on a Sandbox application, and only
# https redirect URLs on a Production one — the two can never share a single
# application. Register one application of each kind, then set these same
# two variable names to a different application's values per environment:
# Sandbox app id/key here in .env.local (matching NEXT_PUBLIC_SITE_URL=
# http://localhost:3000 above), Production app id/key in Vercel's Production
# environment variables (matching that deployment's own https
# NEXT_PUBLIC_SITE_URL). A misconfigured combination (e.g. Production
# credentials with a non-https NEXT_PUBLIC_SITE_URL) fails loudly at server
# startup — see apps/web/instrumentation.ts — rather than silently at the
# first consent attempt.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY_BASE64=
