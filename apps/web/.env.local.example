NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Fallback for building absolute auth redirect URLs (email links) when the
# request's Origin header isn't available. Not needed in normal dev/prod use.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Open Banking (Phase 13, Enable Banking — https://enablebanking.com/cp/applications).
# Server-only, never NEXT_PUBLIC_ — read only from Server Actions / Route Handlers.
# ENABLE_BANKING_APP_ID: the application ID shown in the Control Panel.
# ENABLE_BANKING_PRIVATE_KEY_BASE64: base64 of the downloaded .pem private key
# file's raw bytes (avoids embedding literal newlines in a .env value) —
# e.g. `base64 -i <app-id>.pem | tr -d '\n'`.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY_BASE64=
